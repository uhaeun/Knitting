.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
# ios/ android/ 는 Capacitor 앱 껍데기라 저장소에 둔다 (빌드 산출물은 각 폴더의 .gitignore가 거른다)

# env (secrets)
.env
!.env.example

# local expo module build output
modules/*/android/build/
modules/*/ios/build/
.vercel
.env*
.claude/
