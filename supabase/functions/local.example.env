# Copy to a local ignored .env and replace this placeholder with a generated test-only secret.
MEDIA_SIGNING_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MEDIA_PUBLIC_URL=http://127.0.0.1:54321/functions/v1/revocable-media

# Separate random server-only secret; never EXPO_PUBLIC. Origin-only cannot clear CDN risk.
REVOCATION_WORKER_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
REVOCATION_STORAGE_PUBLIC_URL=http://127.0.0.1:54321
REVOCATION_VERIFICATION=origin
